<!DOCTYPE html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="light dark" />
    <title>Course Detail — Smart Antenna</title>

    <script>
      (function () {
        try {
          var stored = localStorage.getItem("theme");
          if (stored === "dark" || stored === "light") {
            document.documentElement.dataset.theme = stored;
          } else if (
            window.matchMedia("(prefers-color-scheme: dark)").matches
          ) {
            document.documentElement.dataset.theme = "dark";
          }
        } catch (e) {}
      })();
    </script>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=ADLaM+Display&family=Outfit:wght@400;600&family=Paytone+One&family=Pavanam&display=swap"
      rel="stylesheet"
    />

    <link rel="stylesheet" href="/assets/css/reset.css" />
    <link rel="stylesheet" href="/assets/css/variables.css" />
    <link rel="stylesheet" href="/assets/css/main.css" />
    <link rel="stylesheet" href="/assets/css/refresh.css" />
    <link rel="stylesheet" href="/assets/css/course-detail.css" />
  </head>
  <body>
    <!-- Background decorations -->
    <div class="stars" aria-hidden="true">
      <div class="stars__layer stars__layer--1"></div>
      <div class="stars__layer stars__layer--2"></div>
      <div class="stars__layer stars__layer--3"></div>
    </div>

    <!-- Theme toggle button -->
    <button
      type="button"
      class="theme-toggle"
      id="themeToggle"
      aria-label="Switch to dark mode"
      aria-pressed="false"
    >
      <span class="theme-toggle__track" aria-hidden="true">
        <span class="theme-toggle__thumb">
          <svg
            class="theme-toggle__sun"
            viewBox="0 0 24 24"
            fill="currentColor"
            aria-hidden="true"
          >
            <circle cx="12" cy="12" r="5" />
            <line
              x1="12"
              y1="1"
              x2="12"
              y2="3"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
            />
            <line
              x1="12"
              y1="21"
              x2="12"
              y2="23"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
            />
            <line
              x1="4.22"
              y1="4.22"
              x2="5.64"
              y2="5.64"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
            />
            <line
              x1="18.36"
              y1="18.36"
              x2="19.78"
              y2="19.78"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
            />
            <line
              x1="1"
              y1="12"
              x2="3"
              y2="12"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
            />
            <line
              x1="21"
              y1="12"
              x2="23"
              y2="12"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
            />
            <line
              x1="4.22"
              y1="19.78"
              x2="5.64"
              y2="18.36"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
            />
            <line
              x1="18.36"
              y1="5.64"
              x2="19.78"
              y2="4.22"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
            />
          </svg>
          <svg
            class="theme-toggle__moon"
            viewBox="0 0 24 24"
            fill="currentColor"
            aria-hidden="true"
          >
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
          </svg>
        </span>
      </span>
      <span class="theme-toggle__label">Light</span>
    </button>

    <!-- Navigation -->
    <header class="site-nav profile-topbar">
      <div class="container profile-topbar__inner site-nav__inner">
        <a href="/" class="profile-topbar__brand site-nav__brand">Smart Antenna</a>
        <nav class="profile-topbar__links site-nav__links" aria-label="Primary navigation">
          <a href="/courses" class="btn btn--sm">Courses</a>
          <% if(user) { %>
            <a href="/profile" class="btn btn--sm">Profile</a>
            <a href="/logout" class="btn btn--sm btn--login">Logout</a>
          <% } else { %>
            <a href="/profile" class="btn btn--sm">Profile</a>
            <a href="/login" class="btn btn--sm btn--login">Login</a>
          <% } %>
        </nav>
      </div>
    </header>

    <!-- Main page container -->
    <div class="page">
      <div class="background-decoration" aria-hidden="true">
        <div class="bg-blur bg-blur--hero"></div>
        <div class="bg-blur bg-blur--lower"></div>
        <div class="bg-gradient bg-gradient--hero-right"></div>
        <div class="bg-gradient bg-gradient--hero-left"></div>
      </div>

      <main>
        <!-- 1. HERO SECTION -->
        <section class="course-hero">
          <div class="container course-hero__container">
            <div class="course-hero__content">
              <p id="course-category" class="course-hero__description"></p>
              <h1 id="course-title" class="course-hero__title">Loading course…</h1>
              <div class="course-hero__cta-group">
                <button id="enroll-now" class="btn btn--primary">
                  Enroll Now
                </button>
              </div>
            </div>
          <div class="course-hero__image-wrapper">
  <img
    id="course-image"
    class="course-hero__image"
    src=""
    alt="Course image"
  />
</div>
          </div>
        </section>

        <!-- 2. ABOUT THIS COURSE -->
        <section class="course-about">
          <div class="container course-about__container">
            <div class="course-about__content">
              <h2 class="course-about__heading">About this Course</h2>
              <p id="course-description" class="course-about__paragraph"></p>
            </div>

            <!-- Course info card -->
            <aside class="course-info-card">
              <div class="course-info-card__item">
                <svg
                  class="course-info-card__icon"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  aria-hidden="true"
                >
                  <circle cx="12" cy="12" r="1"></circle>
                  <path d="M12 6v6m0 4v2"></path>
                </svg>
                <div class="course-info-card__text">
                  <span class="course-info-card__label">Lectures</span>
                  <span id="course-lecture-count" class="course-info-card__value">—</span>
                </div>
              </div>

              <div class="course-info-card__item">
                <svg
                  class="course-info-card__icon"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  aria-hidden="true"
                >
                  <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8z"></path>
                  <path d="M12 6v6l4 2"></path>
                </svg>
                <div class="course-info-card__text">
                  <span class="course-info-card__label">Level</span>
                  <span id="course-skill-level" class="course-info-card__value">—</span>
                </div>
              </div>

              <div class="course-info-card__item">
                <svg
                  class="course-info-card__icon"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  aria-hidden="true"
                >
                  <path d="M21.21 15.89A10 10 0 1 1 8 2.83"></path>
                  <line x1="22" y1="4" x2="12" y2="14.01"></line>
                </svg>
                <div class="course-info-card__text">
                  <span class="course-info-card__label">Category</span>
                  <span id="course-category-info" class="course-info-card__value">—</span>
                </div>
              </div>

              <button id="enroll-for" class="btn btn--accent course-info-card__enroll">
                Enroll for $199
              </button>
            </aside>
          </div>
        </section>

        <!-- 3. COURSE CURRICULUM -->
        <section class="course-curriculum">
          <div class="container">
            <h2 class="section-heading">Course Curriculum</h2>
            <div class="curriculum-accordion"></div>
          </div>
        </section>

        <!-- 4. INSTRUCTOR SECTION -->
        <section class="course-instructor">
          <div class="container course-instructor__container">
            <div class="instructor-card">
              <div class="instructor-card__image"></div>
              <div class="instructor-card__content">
                <h3 id="lecturer-name" class="instructor-card__name">Loading instructor…</h3>
                <p id="lecturer-email" class="instructor-card__title"></p>
                <p id="lecturer-bio" class="instructor-card__bio"></p>
              </div>
            </div>
          </div>
        </section>
      </main>

      <!-- Footer -->
      <footer class="site-footer" role="contentinfo">
        <div class="container site-footer__container">
          <h3 class="site-footer__heading">Smart Antenna</h3>
          <p class="site-footer__tagline">Learn. Build. Ship.</p>

          <div class="site-footer__meta">
            <nav class="site-footer__social-links" aria-label="Social media">
              <a
                class="site-footer__social-icon-link"
                href="#"
                aria-label="Follow us on Instagram"
              >
                <img
                  class="site-footer__social-icon"
                  src="/assets/images/icons/icon-instagram.png"
                  alt=""
                />
              </a>
              <a
                class="site-footer__social-icon-link"
                href="#"
                aria-label="Follow us on LinkedIn"
              >
                <img
                  class="site-footer__social-icon"
                  src="/assets/images/icons/icon-linkedin.png"
                  alt=""
                />
              </a>
              <a
                class="site-footer__social-icon-link"
                href="#"
                aria-label="Follow us on Facebook"
              >
                <img
                  class="site-footer__social-icon"
                  src="/assets/images/icons/icon-facebook.png"
                  alt=""
                />
              </a>
            </nav>

            <div class="site-footer__legal-links">
              <a href="#" class="site-footer__link">Terms &amp; Conditions</a>
              <a href="#" class="site-footer__link">Privacy Policy</a>
            </div>
          </div>

          <div class="site-footer__bottom">
            &copy; <span id="year">2026</span> Smart Antenna
          </div>
        </div>
      </footer>
    </div>

    <!-- External libraries -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js"></script>
    <script src="/assets/js/main.js"></script>
    <script src="/assets/js/course-detail.js"></script>

    <!-- Utility script for current year -->
    <script>
      try {
        var yearEl = document.getElementById("year");
        if (yearEl) yearEl.textContent = new Date().getFullYear();
      } catch (e) {}
    </script>
  </body>
</html>
