<!DOCTYPE html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="light dark" />
    <title>Courses — Smart Antenna</title>

    <script>
      (function () {
        try {
          var stored = localStorage.getItem("theme");
          if (stored === "dark" || stored === "light") {
            document.documentElement.dataset.theme = stored;
          } else if (
            window.matchMedia("(prefers-color-scheme: dark)").matches
          ) {
            document.documentElement.dataset.theme = "dark";
          }
        } catch (e) {}
      })();
    </script>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=ADLaM+Display&family=Outfit:wght@400;600&family=Paytone+One&family=Pavanam&display=swap"
      rel="stylesheet"
    />

    <link rel="stylesheet" href="/assets/css/reset.css" />
    <link rel="stylesheet" href="/assets/css/variables.css" />
    <link rel="stylesheet" href="/assets/css/main.css" />
    <link rel="stylesheet" href="/assets/css/courses.css" />
    <link rel="stylesheet" href="/assets/css/refresh.css" />
  </head>
  <body>
    <div class="stars" aria-hidden="true">
      <div class="stars__layer stars__layer--1"></div>
      <div class="stars__layer stars__layer--2"></div>
      <div class="stars__layer stars__layer--3"></div>
    </div>

    <button
      type="button"
      class="theme-toggle"
      id="themeToggle"
      aria-label="Switch to dark mode"
      aria-pressed="false"
    >
      <span class="theme-toggle__track" aria-hidden="true">
        <span class="theme-toggle__thumb">
          <svg
            class="theme-toggle__sun"
            viewBox="0 0 24 24"
            fill="currentColor"
            aria-hidden="true"
          >
            <circle cx="12" cy="12" r="5" />
            <line
              x1="12"
              y1="1"
              x2="12"
              y2="3"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
            />
            <line
              x1="12"
              y1="21"
              x2="12"
              y2="23"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
            />
            <line
              x1="4.22"
              y1="4.22"
              x2="5.64"
              y2="5.64"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
            />
            <line
              x1="18.36"
              y1="18.36"
              x2="19.78"
              y2="19.78"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
            />
            <line
              x1="1"
              y1="12"
              x2="3"
              y2="12"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
            />
            <line
              x1="21"
              y1="12"
              x2="23"
              y2="12"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
            />
            <line
              x1="4.22"
              y1="19.78"
              x2="5.64"
              y2="18.36"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
            />
            <line
              x1="18.36"
              y1="5.64"
              x2="19.78"
              y2="4.22"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
            />
          </svg>
          <svg
            class="theme-toggle__moon"
            viewBox="0 0 24 24"
            fill="currentColor"
            aria-hidden="true"
          >
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
          </svg>
        </span>
      </span>
      <span class="theme-toggle__label">Light</span>
    </button>

    <header class="site-nav courses-topbar">
      <div class="container courses-topbar__inner site-nav__inner">
        <a href="/" class="courses-topbar__brand site-nav__brand">Smart Antenna</a>
        <nav class="courses-topbar__links site-nav__links" aria-label="Primary navigation">
          <a href="/" class="btn btn--sm">Home</a>
          <a href="/courses" class="btn btn--sm">Courses</a>
          <% if(user) { %>
            <a href="/profile" class="btn btn--sm">Profile</a>
            <a href="/logout" class="btn btn--sm btn--login">Logout</a>
          <% } else { %>
            <a href="/login" class="btn btn--sm btn--login">Login</a>
          <% } %>
        </nav>
      </div>
    </header>

    <div class="page">
      <div class="background-decoration" aria-hidden="true">
        <div class="bg-blur bg-blur--hero"></div>
        <div class="bg-blur bg-blur--lower"></div>
        <div class="bg-gradient bg-gradient--hero-right"></div>
        <div class="bg-gradient bg-gradient--hero-left"></div>
      </div>

      <main class="courses-container">
        <div class="courses-hero">
          <h1 class="courses-hero__title">Explore Our Courses</h1>
          <p class="courses-hero__description">
            Learn from industry experts and advance your skills across diverse topics
          </p>
        </div>

        <div class="courses-filters">
          <div class="courses-sidebar">
            <!-- Course Categories -->
            <div class="courses-panel">
              <h3 class="courses-panel__title">Course Category</h3>
              <div class="courses-panel__content">
                <div class="courses-list">
                </div>
              </div>
            </div>

            <!-- Skill Level Filter -->
            <div class="courses-panel">
              <h3 class="courses-panel__title">Skill Level</h3>
              <div class="courses-panel__content">
                <label class="filter-checkbox">
                  <input type="checkbox" value="high" class="skill-filter" />
                  <span>Advanced</span>
                </label>
                <label class="filter-checkbox">
                  <input type="checkbox" value="medium" class="skill-filter" />
                  <span>Intermediate</span>
                </label>
                <label class="filter-checkbox">
                  <input type="checkbox" value="low" class="skill-filter" />
                  <span>Beginner</span>
                </label>
              </div>
            </div>

            <!-- Duration Filter -->
            <div class="courses-panel">
              <h3 class="courses-panel__title">Duration</h3>
              <div class="courses-panel__content">
                <label class="filter-checkbox">
                  <input type="checkbox" value="1-10" class="duration-filter" />
                  <span>1-10 Hours</span>
                </label>
                <label class="filter-checkbox">
                  <input type="checkbox" value="11-20" class="duration-filter" />
                  <span>10-20 Hours</span>
                </label>
                <label class="filter-checkbox">
                  <input type="checkbox" value="21-30" class="duration-filter" />
                  <span>20-30 Hours</span>
                </label>
              </div>
            </div>
          </div>

          <!-- Courses Grid -->
          <div class="courses-grid-container">
            <div class="courses-grid" id="coursesGrid">
              <!-- Course cards will be generated here -->
            </div>
          </div>
        </div>
      </main>

      <footer class="site-footer" role="contentinfo">
        <div class="container site-footer__container">
          <h3 class="site-footer__heading">Smart Antenna</h3>
          <p class="site-footer__tagline">Learn. Build. Ship.</p>

          <div class="site-footer__meta">
            <nav class="site-footer__social-links" aria-label="Social media">
              <a
                class="site-footer__social-icon-link"
                href="#"
                aria-label="Follow us on Instagram"
              >
                <img
                  class="site-footer__social-icon"
                  src="/assets/images/icons/icon-instagram.png"
                  alt=""
                />
              </a>
              <a
                class="site-footer__social-icon-link"
                href="#"
                aria-label="Follow us on LinkedIn"
              >
                <img
                  class="site-footer__social-icon"
                  src="/assets/images/icons/icon-linkedin.png"
                  alt=""
                />
              </a>
              <a
                class="site-footer__social-icon-link"
                href="#"
                aria-label="Follow us on Facebook"
              >
                <img
                  class="site-footer__social-icon"
                  src="/assets/images/icons/icon-facebook.png"
                  alt=""
                />
              </a>
            </nav>

            <div class="site-footer__legal-links">
              <a href="#" class="site-footer__link">Terms &amp; Conditions</a>
              <a href="#" class="site-footer__link">Privacy Policy</a>
            </div>
          </div>

          <div class="site-footer__bottom">
            &copy; <span id="year">2026</span> Smart Antenna
          </div>
        </div>
      </footer>
    </div>

    <script src="/assets/js/main.js"></script>
    <script src="/assets/js/courses.js"></script>
    <script>
      
      try {
        var yearEl = document.getElementById("year");
        if (yearEl) yearEl.textContent = new Date().getFullYear();
      } catch (e) {}
    </script>
  </body>
</html>
